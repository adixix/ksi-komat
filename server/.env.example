# Połączenie z MariaDB (kopiuj do server/.env i uzupełnij)
DB_HOST=przyba.pl
DB_PORT=3306
DB_USER=ksiazkomat
DB_PASSWORD=twoje-haslo
DB_NAME=ksiazkomat

# Sekret sesji — ustaw losowy ciąg (np. `openssl rand -hex 32`)
SESSION_SECRET=zmien-mnie-na-losowy-ciag

# Port API (dev: 3001)
PORT=3001

# Token dostępu do kanału RSS: /feed.rss?token=<wartość>
FEED_TOKEN=

# Bazowy URL Open Library (bez / na końcu)
OPENLIBRARY_BASE=https://openlibrary.org

# Opcjonalnie: klucz Google Books API (Books API) — fallback, gdy Open Library
# nie zna danego ISBN (np. polskie wydania). Bez klucza fallback jest wyłączony.
# Darmowy klucz: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=
